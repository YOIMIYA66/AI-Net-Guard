<Application x:Class="AiNetGuard.Gui.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- Apple Cupertino Clean Matte Palette (No Liquid Glass) -->
        <SolidColorBrush x:Key="AppBgBrush" Color="#F5F5F7"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#E5E5EA"/>
        <SolidColorBrush x:Key="DividerBrush" Color="#F0F0F2"/>

        <!-- Typography Palette (Apple Human Interface Guidelines) -->
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1D1D1F"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6E6E73"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#86868B"/>

        <!-- Apple System Accent (Cupertino Blue) -->
        <SolidColorBrush x:Key="AccentBrush" Color="#0071E3"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#0077ED"/>
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#0062C4"/>

        <!-- Apple System Green (Subtle Pill & Toggle Switch) -->
        <SolidColorBrush x:Key="SuccessBrush" Color="#34C759"/>
        <SolidColorBrush x:Key="SuccessBgBrush" Color="#EAF7EE"/>
        <SolidColorBrush x:Key="SuccessBorderBrush" Color="#D2F2DA"/>
        <SolidColorBrush x:Key="SuccessTextBrush" Color="#1E7E34"/>

        <!-- Apple System Amber (Warnings) -->
        <SolidColorBrush x:Key="WarnBrush" Color="#F59E0B"/>
        <SolidColorBrush x:Key="WarnBgBrush" Color="#FFF8E1"/>
        <SolidColorBrush x:Key="WarnBorderBrush" Color="#FFE082"/>
        <SolidColorBrush x:Key="WarnTextBrush" Color="#B45309"/>

        <!-- Apple System Rose / Red (Destructive Actions) -->
        <SolidColorBrush x:Key="DangerBrush" Color="#E11D48"/>
        <SolidColorBrush x:Key="DangerBgBrush" Color="#FFF1F2"/>
        <SolidColorBrush x:Key="DangerHoverBgBrush" Color="#FFE4E6"/>
        <SolidColorBrush x:Key="DangerBorderBrush" Color="#FECDD3"/>

