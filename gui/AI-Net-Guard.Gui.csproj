<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>12.0</LangVersion>
    <AssemblyName>AI-Net-Guard</AssemblyName>
    <RootNamespace>AiNetGuard.Gui</RootNamespace>
    <Version>5.5.2</Version>
    <AssemblyVersion>5.5.2.0</AssemblyVersion>
    <FileVersion>5.5.2.0</FileVersion>
    <Product>AI-Net-Guard</Product>
    <Description>AI-Net-Guard v5.5.2 Windows Native Kernel Fail-Closed Split-Tunnel Configurator</Description>
    <Copyright>Copyright (c) AI-Net-Guard Contributors (MIT License)</Copyright>
    <ApplicationManifest Condition="'$(SmokeTestBuild)' != 'true'">app.manifest</ApplicationManifest>
    <ApplicationManifest Condition="'$(SmokeTestBuild)' == 'true'">app.smoketest.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('obj\app.ico')">obj\app.ico</ApplicationIcon>
    <GenerateResourceUsePreserializedResources>false</GenerateResourceUsePreserializedResources>
    <Deterministic>true</Deterministic>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <ItemGroup Condition="Exists('obj\payload.zip')">
    <EmbeddedResource Include="obj\payload.zip">
      <LogicalName>AiNetGuard.Payload.zip</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
